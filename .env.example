# Copy to .env.local (never committed) and fill in.

# Stripe — use TEST keys (sk_test_ / pk_test_) until you are ready to go live.
STRIPE_SECRET_KEY=sk_test_replace_me
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally,
# or from the webhook endpoint in the Stripe dashboard in production.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Set to "enabled" only when switching to live keys. Live keys are refused without it.
STRIPE_LIVE_MODE=

# Canonical site URL used for metadata, sitemap and Stripe redirect URLs.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: JSON endpoint for the live revenue stat (see README). Falls back to src/data/stats.json.
STATS_SOURCE_URL=
